    function t(key, fallback) {
        var currentDict = dicts[lang] || dicts["zh"];
        if (currentDict && currentDict[key] !== undefined) {
            return currentDict[key];
        }
        var zhDict = dicts["zh"];
        if (zhDict && zhDict[key] !== undefined) {
            return zhDict[key];
        }
        return fallback !== undefined ? fallback : key;
    }
